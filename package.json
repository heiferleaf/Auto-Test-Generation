{
  "name": "electron-auto-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向 Electron 桌面客户端的自动化测试平台（CDP + Playwright + 自研 MCP）",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "run": "tsx src/cli-main.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "playwright": "^1.44.0",
    "ws": "^8.18.0"
  }
}
